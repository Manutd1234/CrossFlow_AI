{
  "version": 2,
  "env": {
    "VITE_API_ENABLED": "true",
    "CROSSFLOW_WARM_ROUTING_CACHES": "0",
    "CROSSFLOW_REQUIRE_DURABLE_FERRY_FRESHNESS": "1",
    "CROSSFLOW_FERRY_FRESHNESS_FALLBACK": "committed_snapshot",
    "CROSSFLOW_AUTH_MODE": "supabase",
    "CROSSFLOW_REAL_TRAFFIC_TRAINING": "1",
    "CROSSFLOW_REAL_MODEL_PATH": "backend/data/observed_runtime_model.json",
    "CROSSFLOW_CCTV_STORE": "supabase"
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
