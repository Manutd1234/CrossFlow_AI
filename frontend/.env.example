VITE_API_ENABLED=true
# Leave blank locally to use Vite's /api proxy to localhost:8000.
VITE_API_BASE_URL=

# Same project and browser-safe key as ../.env. Never put a server secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional alternate browser tile provider. Set the matching attribution too.
# Blank uses standard OpenStreetMap tiles; browser caching stays enabled.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional disposable local-development account only; ignored in production builds.
# The Vite dev server exposes these values to its browser clients. Leave blank normally.
VITE_TEST_ADMIN_EMAIL=
VITE_TEST_ADMIN_PASSWORD=
