# Emergency demo mode. Set false to skip unavailable application API calls and
# use the browser's bundled corridor, operations, and route simulations.
VITE_API_ENABLED=true

# Server-only durability configuration. Never put either server credential in
# a VITE_ or NEXT_PUBLIC_ variable.
SUPABASE_URL=
# Preferred modern server-only credential. Legacy deployments may use the
# service-role key below instead; never expose either one to browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Apply backend/data/ferry_freshness.sql for shared ferry verification. Apply
# backend/data/routing_intelligence.sql only when the optional durable traffic
# observation and shortcut review/approval store is required.

# The optional routing-intelligence schema is never probed just because ferry
# freshness uses the same Supabase project. Keep local until its SQL migration
# is applied; then set supabase in Preview/Production.
CROSSFLOW_ROUTING_INTELLIGENCE_STORE=local

# vercel.json pins this to 1 for every deployment. Keep 0 only for local
# committed-snapshot fallback, or set 1 locally to test the fail-closed path.
CROSSFLOW_REQUIRE_DURABLE_FERRY_FRESHNESS=0

# Route-only fallback for exact departure/arrive-by planning when the durable
# ferry freshness store is unavailable. Uses the immutable bundled timetable
# and labels the result as simulated; refresh operations still fail closed.
# Leave blank to retain the strict durable-freshness requirement.
CROSSFLOW_FERRY_FRESHNESS_FALLBACK=

# Only needed for an audited self-hosted Supabase-compatible HTTPS endpoint.
CROSSFLOW_SUPABASE_ALLOWED_HOST=

# --- Human sign-in for admins and drivers (backend/auth) --------------------
# Off until explicitly enabled, so a project without backend/auth/schema.sql
# applied keeps serving every public corridor, ferry and model endpoint.
# Set to `supabase` once the schema is applied. Values: disabled | supabase
CROSSFLOW_AUTH_MODE=disabled

# The browser-safe key, and the only Supabase credential that may appear in
# client code. It identifies the project; it grants nothing on its own, because
# row-level security decides what a request may read from the caller's own JWT.
# NEVER put SUPABASE_SECRET_KEY here or in any client-visible variable: the
# secret key bypasses row-level security entirely, which would let any signed-in
# driver read every other driver's journey while the app still looks correct.
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still call this SUPABASE_ANON_KEY; either is accepted.
SUPABASE_ANON_KEY=

# Browser configuration belongs in frontend/.env.local (see that directory's
# .env.example). Use the same project URL and publishable key in both files.

# Optional one-click shared admin for a disposable demo/test Supabase project.
# Vite embeds both values in the public browser bundle: this is intentionally a
# public test credential, never a secret and never suitable for production data.
# Put these in frontend/.env.local for local Vite development, or configure them
# only on the dedicated test deployment. Leave both blank to hide the button.
VITE_TEST_ADMIN_EMAIL=
VITE_TEST_ADMIN_PASSWORD=

# Local routing is the default and remains the critical-path fallback. The
# legacy `supabase` adapter is intentionally disabled because it cannot prove
# vehicle constraints. Use supabase_v2_constrained only after installing and
# validating a complete replacement RPC contract.
CROSSFLOW_ROUTE_PROVIDER=local

# Synchronous alternative-route search budgets. These affect only the bounded
# alternative search; the primary route remains outside these limits.
CROSSFLOW_ALTERNATIVE_MAX_SEARCHES=3
CROSSFLOW_ALTERNATIVE_TIME_BUDGET_MS=10000
CROSSFLOW_ALTERNATIVE_MAX_SETTLED_STATES=250000

# Local congestion-history storage. A normal file is single-host durable;
# serverless /tmp and the automatic in-memory fallback are explicitly ephemeral.
CROSSFLOW_HISTORY_DB=

# Opt-in LOCAL background archive of validated live TomTom samples every120s.
# Starts recording now; never creates historical measurements or synthetic rows.
# Uses the configured local history DB. Disabled on serverless/shared-store mode.
CROSSFLOW_ARCHIVE_LIVE_TRAFFIC=0

# Server-only CCTV registry and numeric aggregate store. Blank uses bundled
# registry and backend/data/cctv_observations.sqlite. The collector and API
# must share persistent local paths. Six reviewed public Matanya views are enabled.
# See docs/CCTV_CONGESTION.md for source-clock and calibration requirements.
CROSSFLOW_CCTV_REGISTRY=
CROSSFLOW_CCTV_DB=
# Local SQLite is the default. Vercel always requires the shared Supabase store;
# apply backend/data/cctv_observations.sql with the backend server credential.
CROSSFLOW_CCTV_STORE=local
# A CCTV-only machine credential accepted solely by the numeric ingest endpoint.
# Keep it server-only; use a generated token of at least 32 characters. Never
# put it in a VITE_ variable or pass a Supabase/admin key to the vision worker.
CROSSFLOW_CCTV_INGEST_TOKEN=
# External YOLO collector only: HTTPS URL ending exactly in the path below.
# Example: https://cross-flow-ai.vercel.app/api/internal/cctv-observations
# Leave blank in Vercel. No video or image bytes are delivered to the cloud API.
CROSSFLOW_CCTV_INGEST_URL=
# Optional server-only ledger for forecasts scored against future measured traffic.
# Blank keeps backend/data/forecast_evaluation.sqlite; viewing summaries is read-only.
CROSSFLOW_FORECAST_EVALUATION_DB=
# Optional causal weather archive. Serverless defaults for this and forecast
# evaluation are /tmp/crossflow-ai/*.db and are explicitly instance-ephemeral.
CROSSFLOW_WEATHER_DB=
# Local API supervises enabled cameras with the optional YOLO26 runtime.
# Set 0 to disable; serverless execution never launches background capture.
CROSSFLOW_CCTV_ENABLED=1
CROSSFLOW_CCTV_PYTHON=
# Hard concurrent-worker limit (default 2, bounded by CPU and at most 8).
# Six permits continuous monitoring of the six reviewed views on the local host.
CROSSFLOW_CCTV_MAX_CONCURRENT=6
# Only used when eligible cameras exceed capacity; at least 60s per turn.
CROSSFLOW_CCTV_SLICE_SECONDS=60

# Optional trusted server path for an eligible measured-only model artifact.
# Training persists verified numeric JSON before activation; startup restores
# only a valid eligible observed model. No HTTP caller can choose this path.
CROSSFLOW_OBSERVED_MODEL_PATH=
# Existing TomTom keys may be entered locally through the temporary loopback
# setup form: python scripts/configure_tomtom_local.py. It writes the ignored
# .env.tomtom.local; dev.sh reads it without sourcing executable shell code.
# TOMTOM_API_KEY supplies current Traffic Flow; historical Traffic Stats may
# require a separate entitled MOVE key. Neither key may have a VITE_ prefix.

# Optional LOCAL-only current traffic relay when TOMTOM_API_KEY is absent.
# Leave empty by default. The only accepted public URL is:
# https://cross-flow-ai.vercel.app/api/live-traffic
# No credentials are sent. Validated segments are cached in process memory,
# never ingested into training history. Disabled on Vercel/AWS Lambda to avoid
# a deployment relaying requests back to itself; do not set it in cloud config.
CROSSFLOW_TRAFFIC_UPSTREAM_URL=

# Typed spatial observations default to five years. The accepted range is
# 365..7300 days; retention cleanup never relabels synthetic data as observed.
CROSSFLOW_SPATIAL_HISTORY_RETENTION_DAYS=1825

# Identity of the audited producer bound to the admin-only observation API.
# The request body cannot self-declare a high-trust source. Supported values:
# loop_sensor, probe_gps, tomtom_live, verified_traffic_observation.
CROSSFLOW_TRAFFIC_INGEST_SOURCE=

# Immutable reviewer identity attached to shortcut approvals. This comes from
# deployment configuration, never the request body or shared admin token.
CROSSFLOW_SHORTCUT_REVIEWER_ID=

# Optional SQLite store for verified, exact-edge traversal learning.
CROSSFLOW_ROUTE_LEARNING_DB=

# Server-owned pinned-source JSON policy for crowd shortcut candidates. Blank
# disables source fetching. Audit every real URL before enabling it; incoming
# tips remain REVIEW_REQUIRED and cannot activate a graph edge.
CROSSFLOW_SHORTCUT_SOURCE_POLICY=
# Example shape (placeholder URL; do not enable unchanged):
# CROSSFLOW_SHORTCUT_SOURCE_POLICY={"schema_version":1,"sources":[{"source_id":"reviewed_batam_tips","pinned_urls":["https://tips.example.org/audited/batam-shortcuts.json"],"allowed_content_types":["application/json"],"confidence_ceiling":0.6}],"limits":{"max_document_bytes":262144,"max_documents_per_batch":20,"max_tips_per_document":64,"max_tips_per_batch":200,"max_excerpt_chars":320}}

# Protect backend ingestion, review/promotion, persistence-status and retraining
# operations. Send this value only in X-CrossFlow-Admin-Token; never expose it
# through a VITE_ or NEXT_PUBLIC_ variable and do not reuse a Supabase secret.
CROSSFLOW_ADMIN_TOKEN=

# Route-code retrieval is public in the current dispatch workflow. A code can
# retrieve its route; treat codes as shareable dispatch capabilities. These
# legacy token settings do not restrict that public endpoint.
CROSSFLOW_ROUTE_READ_TOKEN=
CROSSFLOW_ROUTE_DB=

# Local development only: authenticated route history in the local route DB.
# Explicit opt-in; never enabled on serverless deployments. For shared hosted
# history apply backend/data/route_runs.sql and configure a server-only key.
CROSSFLOW_LOCAL_ROUTE_HISTORY=0
# Observed-only runtime; local opt-in also enables background training/capture.
# Vercel pins this to 1 and uses the reviewed data-only deployment snapshot;
# automatic training/capture remain disabled on serverless. Cloud forecasts
# use current genuine provider samples and persistence, without claiming a
# shared historical lag archive or prospective evaluation.
CROSSFLOW_REAL_TRAFFIC_TRAINING=0
CROSSFLOW_REAL_MODEL_PATH=
